# 复制为 .env 后填写：cp .env.example .env
# .env 不会被提交到 Git，也不会被打进镜像。docker compose 会把它整个传给 ledger-snap 容器。

# ---- 服务必填 ----
# OpenRouter 密钥，用于决策模型和视觉 LLM 兜底
OPENROUTER_API_KEY=
# 邀请码，逗号分隔，例如 abc123,def456；没有邀请码任何人都无法登录
LEDGER_SNAP_INVITE_CODES=

# 决策模型直接走 TypeSafe 官方接口时填写（config.toml 里 decision.provider = "typesafe"）
TYPESAFE_AI_API_KEY=

# ---- OCR：只需要填 config.toml 里 ocr.provider 用到的那一家 ----
# 火山引擎多语种 OCR（默认）
VOLCANO_OCR_ACCESS_KEY=
VOLCANO_OCR_SECRET_KEY=
# 谷歌 Cloud Vision
GOOGLE_OCR_API_KEY=
# 百度 OCR
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ---- 可选：覆盖 config.toml 里的配置 ----
# 每一项都能覆盖：LEDGER_SNAP_ 加上配置项路径的大写，点换成下划线。
# 完整列表：docker compose exec ledger-snap /app/ledger-snap config
# 留空表示用默认值；拼错的变量名会让服务拒绝启动。改完运行 docker compose up -d 生效。
#
# OCR 服务：volcano | google | baidu
# LEDGER_SNAP_OCR_PROVIDER=volcano
# 决策模型走 openrouter 还是 typesafe；走 typesafe 时模型填 jev-latest
# LEDGER_SNAP_DECISION_PROVIDER=openrouter
# LEDGER_SNAP_DECISION_MODEL=typesafe/jev-1.14
# 视觉 LLM 兜底，以及“用一句话改”用的模型
# LEDGER_SNAP_FALLBACK_ENABLED=true
# LEDGER_SNAP_FALLBACK_MODEL=anthropic/claude-haiku-5.5
# LEDGER_SNAP_CORRECTION_MODEL=anthropic/claude-haiku-5.5
# 有拿不准的字段时先不记账，等确认
# LEDGER_SNAP_RECOGNIZE_CONFIRM_UNCERTAIN=true
# LEDGER_SNAP_RECOGNIZE_TIMEZONE=Asia/Shanghai
# 截图保留天数
# LEDGER_SNAP_SERVER_IMAGE_RETENTION_DAYS=30
# 分类、账户的置信度低于这个值时标为拿不准
# LEDGER_SNAP_DECISION_THRESHOLDS_CATEGORY=0.4
# LEDGER_SNAP_DECISION_THRESHOLDS_ASSET=0.4

# ---- 部署选项，由 docker compose 自己读取 ----
# 镜像，留空时用 ghcr.io/cr-zhichen/ledger-snap:latest。建议固定版本，例如 ghcr.io/cr-zhichen/ledger-snap:0.1.0；
# 升级时改这里，再 docker compose pull && docker compose up -d
LEDGER_SNAP_IMAGE=
# 宿主机端口，默认 8080；反向代理在同一台机器上时建议写 127.0.0.1:8080，只对本机开放
LEDGER_SNAP_PORT=8080
# 容器启动时把 ./data 交给这个用户，再以它的身份运行。填 id -u 和 id -g 的结果，
# 宿主机上的你就能直接读写 data；留空用 65532；填 0 表示一直以 root 运行
LEDGER_SNAP_UID=1000
LEDGER_SNAP_GID=1000
