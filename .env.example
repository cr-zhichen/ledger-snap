# 复制为 .env 后填写：cp .env.example .env
# .env 不会被提交到 Git，也不会被打进镜像。docker compose 会把它整个传给 ledger-snap 容器。

# ---- 服务必填 ----
# OpenRouter 密钥，用于决策模型和视觉 LLM 兜底
OPENROUTER_API_KEY=
# 邀请码，逗号分隔，例如 abc123,def456；没有邀请码任何人都无法登录
LEDGER_SNAP_INVITE_CODES=

# 决策模型直接走 TypeSafe 官方接口时填写（config.toml 里 decision.provider = "typesafe"）
TYPESAFE_AI_API_KEY=

# ---- OCR：只需要填 config.toml 里 ocr.provider 用到的那一家 ----
# 火山引擎多语种 OCR（默认）
VOLCANO_OCR_ACCESS_KEY=
VOLCANO_OCR_SECRET_KEY=
# 谷歌 Cloud Vision
GOOGLE_OCR_API_KEY=
# 百度 OCR
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ---- 部署选项，由 docker compose 自己读取 ----
# 使用 GitHub 发布的镜像时填写，例如 ghcr.io/cr-zhichen/ledger-snap:latest；留空则用本地构建的镜像
LEDGER_SNAP_IMAGE=
# 宿主机端口，默认 8080；反向代理在同一台机器上时建议写 127.0.0.1:8080，只对本机开放
LEDGER_SNAP_PORT=8080
# 容器以这个用户身份运行，才能写入映射的 ./data；分别填 id -u 和 id -g 的结果
LEDGER_SNAP_UID=1000
LEDGER_SNAP_GID=1000
